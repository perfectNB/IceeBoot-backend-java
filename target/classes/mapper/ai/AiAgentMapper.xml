<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zboot.framework.mapper.ai.AiAgentMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.zboot.framework.entity.ai.AiAgentDO">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="name" property="name" jdbcType="VARCHAR"/>
        <result column="type" property="type" jdbcType="VARCHAR"/>
        <result column="remark" property="remark" jdbcType="VARCHAR"/>
        <result column="platform" property="platform" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="VARCHAR"/>
        <result column="token" property="token" jdbcType="VARCHAR"/>
        <result column="bot_id" property="botId" jdbcType="VARCHAR"/>
        <result column="work_flow_id" property="workFlowId" jdbcType="VARCHAR"/>
        <result column="key" property="key" jdbcType="VARCHAR"/>
        <result column="create_by" property="createBy" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_by" property="updateBy" jdbcType="VARCHAR"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
        <result column="del_flag" property="delFlag" jdbcType="TINYINT"/>
    </resultMap>

    <!-- 基础字段 -->
    <sql id="Base_Column_List">
        id, name, type, remark, platform, status, token, bot_id, work_flow_id, `key`,
        create_by, create_time, update_by, update_time, del_flag
    </sql>

    <!-- 根据平台查询代理列表 -->
    <select id="selectByPlatform" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM t_ai_agent
        WHERE platform = #{platform}
        AND del_flag = 0
        ORDER BY create_time DESC
    </select>

    <!-- 根据类型查询代理列表 -->
    <select id="selectByType" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM t_ai_agent
        WHERE type = #{type}
        AND del_flag = 0
        ORDER BY create_time DESC
    </select>

    <!-- 根据平台和类型查询代理列表 -->
    <select id="selectByPlatformAndType" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM t_ai_agent
        WHERE platform = #{platform}
        AND type = #{type}
        AND del_flag = 0
        ORDER BY create_time DESC
    </select>

    <!-- 根据状态查询代理列表 -->
    <select id="selectByStatus" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM t_ai_agent
        WHERE status = #{status}
        AND del_flag = 0
        ORDER BY create_time DESC
    </select>

</mapper>