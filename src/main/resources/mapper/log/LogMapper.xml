<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zboot.framework.mapper.log.LogMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.zboot.framework.entity.log.LogDO">
        <id column="id" property="id" />
        <result column="level" property="level" />
        <result column="module" property="module" />
        <result column="message" property="message" />
        <result column="thread" property="thread" />
        <result column="class_name" property="className" />
        <result column="stack_trace" property="stackTrace" />
        <result column="timestamp" property="timestamp" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="create_by" property="createBy" />
        <result column="update_by" property="updateBy" />
        <result column="deleted" property="deleted" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, level, module, message, thread, class_name, stack_trace, timestamp, create_time, update_time, create_by, update_by, deleted
    </sql>

</mapper>